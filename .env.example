# Central Environment Configuration
# Backend & Frontend Port allocations (Allowed: 7001, 7002, 7003+)
SERVER_PORT=7001
FRONTEND_PORT=7002
NEXT_PUBLIC_API_URL=http://localhost:7001

# PostgreSQL Configuration
POSTGRES_USER=mrcool
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=auth_pdf_db
POSTGRES_PORT=7003
POSTGRES_DATA_DIR=./data/postgres

# Redis Configuration
REDIS_PORT=7004
REDIS_PASSWORD=
REDIS_DATA_DIR=./data/redis

# MinIO (S3 Data Store) Configuration
MINIO_API_PORT=7005
MINIO_CONSOLE_PORT=7006
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_DATA_DIR=./data/minio
MINIO_BUCKET_NAME=pdf-documents

# JWT Configuration
JWT_SECRET=your_jwt_secret_base64_encoded_256_bit_minimum
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
